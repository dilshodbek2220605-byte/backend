# ------------------------------------------------------------------
# 1) MAHALLIY POSTGRESQL (Local)
#    Windows standart o'rnatishda port 5432 bo'ladi.
#    PAROLni o'zingizning postgres parolingizga almashtiring.
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:firdavs12345@localhost:5432/shablon?schema=public"

# ------------------------------------------------------------------
# 2) BULUTLI POSTGRES (Neon / Supabase / Railway) - cloud-ready
#    Faqat shu qatorni almashtirasiz, boshqa hech narsa o'zgarmaydi:
#    npx prisma migrate deploy  -> tamom.
#
# Neon (pooled + direct):
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/shablon?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/shablon?sslmode=require"
#
# Supabase:
# DATABASE_URL="postgresql://postgres.xxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.xxx:pass@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
# ------------------------------------------------------------------

# JWT maxfiy kaliti - ishlab chiqarishda albatta o'zgartiring!
JWT_SECRET="shablon-pos-dev-secret-almashtiring"
JWT_EXPIRES_IN="12h"

PORT=5432
NODE_ENV=development

# Telefonda sinash uchun: kompyuteringizning LAN IP manzili
CLIENT_ORIGIN="http://localhost:5173"

